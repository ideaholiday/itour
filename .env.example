# Mappls static key for pickup autocomplete, place resolution and reverse geocoding.
# The key stays on the server and is never exposed to the browser bundle.
MAPPLS_API_KEY=
MAPPLS_ORIGIN=https://ideaholiday.in
# GOOGLE_PLACES_API_KEY=

# Existing Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_ENGINE=sqlite
DATABASE_URL=
POSTGRES_SCHEMA=marketplace

# SQLite remains available for local development. Production Cloud Run uses
# DATABASE_ENGINE=postgres with Supabase as the persistent source of truth.
SQLITE_DB_PATH=
SQLITE_PERSISTENT_VOLUME=false
SQLITE_JOURNAL_MODE=WAL

# Destructive demo seed commands are blocked unless this is explicitly true.
ALLOW_DESTRUCTIVE_SEED=false

# Express marketplace API used by the checkout dispatch handoff
IDEA_HOLIDAY_API_URL=http://localhost:4000

# Marketplace checkout. Demo-only mode is enabled by default so no customer is charged.
# Set DEMO_PAYMENT_ONLY=false only when the live gateway is ready to be restored.
DEMO_PAYMENT_ONLY=true
ENABLE_DEMO_PAYMENT=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree Payment Gateway configuration
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST
CASHFREE_API_VERSION=2023-08-01

# Cashfree SecureID (KYB Verification Suite) configuration
CASHFREE_SECUREID_CLIENT_ID=
CASHFREE_SECUREID_CLIENT_SECRET=
CASHFREE_SECUREID_ENV=TEST
CASHFREE_SECUREID_API_VERSION=2024-01-01
# 2FA Public Key configuration (PEM file path or raw string / base64)
CASHFREE_SECUREID_PUBLIC_KEY_PATH=
CASHFREE_SECUREID_PUBLIC_KEY=
CASHFREE_SECUREID_MERCHANT_ID=
CASHFREE_SECUREID_ACCOUNT_ID=
CASHFREE_SECUREID_PROXY_URL=
CASHFREE_SECUREID_SIMULATION_FALLBACK=true

# Use long, independent random values in production. Changing OTP_SECRET makes
# existing encrypted pickup codes unreadable, so rotate it with a migration plan.
JWT_SECRET=
OTP_SECRET=
ADMIN_EMAIL=admin@ideaholiday.in
ADMIN_INITIAL_PASSWORD=

# Browser/API security. Production should list only the deployed frontend
# origins. TRUST_PROXY_HOPS=1 matches a single managed reverse proxy.
ALLOWED_ORIGINS=https://ideaholiday.in
TRUST_PROXY_HOPS=1
GLOBAL_RATE_LIMIT=1000
AUTH_RATE_LIMIT=5
SEARCH_RATE_LIMIT=30
CHECKOUT_RATE_LIMIT=10

# Structured stdout logging for Cloud Run.
LOG_LEVEL=info
LOG_FORMAT=json
SLOW_REQUEST_MS=1000
LOG_REQUEST_BODY=false

# Prometheus-compatible metrics. Generate at least 32 random characters and
# send it as a bearer credential (preferred) or X-Metrics-Token when scraping.
METRICS_TOKEN=
METRICS_DEFAULTS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Supplier booking response SLA. Cloud Scheduler can call
# POST /api/ops/process-assignment-timeouts with X-Scheduler-Token.
SUPPLIER_ACCEPTANCE_MINUTES=10
ASSIGNMENT_SCHEDULER_TOKEN=

# Keep false/unset unless a real payout provider is wired. When true, the
# current supplier transfer routine is explicitly treated as demo behavior.
ENABLE_DEMO_PAYOUTS=false

# Transactional notifications. Keep disabled until provider identities,
# templates and webhook verification have been completed in production.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=BREVO
BREVO_API_KEY=
BREVO_SENDER_NAME=Idea Holiday
BREVO_SENDER_EMAIL=info@ideaholiday.com
EMAIL_FROM=info@ideaholiday.com
SES_REGION=ap-south-1
SES_FROM_EMAIL=no-reply@ideaholiday.in
SES_REPLY_TO_EMAIL=support@ideaholiday.in
SES_CONFIGURATION_SET=

# Prefer an IAM role in production. Use access keys only in the hosting secret
# manager; never commit them to this file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_API_VERSION=v22.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_SENDER_PHONE=
WHATSAPP_TIMEOUT=15
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved Meta template names. Body variable order is documented in README.md.
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_BOOKING_DOCUMENTS=
WHATSAPP_TEMPLATE_SUPPLIER_ASSIGNMENT=
WHATSAPP_TEMPLATE_SUPPLIER_ACCEPTED=
WHATSAPP_TEMPLATE_DRIVER_ASSIGNED=
WHATSAPP_TEMPLATE_DRIVER_TRIP=
WHATSAPP_TEMPLATE_SUPPLIER_STATUS=
WHATSAPP_TEMPLATE_OPS_ALERT=
WHATSAPP_TEMPLATE_TRIP_STATUS=
WHATSAPP_TEMPLATE_REFUND_STATUS=
WHATSAPP_TEMPLATE_PAYOUT_STATUS=
WHATSAPP_TEMPLATE_SUPPORT_CASE=
WHATSAPP_TEMPLATE_PRODUCT_PUBLISHED=

# Secure guest voucher and invoice links
PUBLIC_APP_URL=https://ideaholiday.in
DOCUMENT_LINK_SECRET=
BUSINESS_LEGAL_NAME=Idea Holiday
BUSINESS_GSTIN=
BUSINESS_ADDRESS=
