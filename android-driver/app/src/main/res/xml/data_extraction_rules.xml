<?xml version="1.0" encoding="utf-8"?>
<!-- The trip link is private to one driver and one trip: never back it up or move it to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
